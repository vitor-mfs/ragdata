# Chave da API do Divine Pride — pegue a sua em https://www.divine-pride.net/account
DIVINE_PRIDE_API_KEY=

# Servidor (região) consultado no Divine Pride. O Ragnarok LATAM é publicado como LATAM.
# Outros aliases aceitos: bRO, cRO, dpRO, idRO, GGH, GZero, iRO, jRO, kROM, kROZ, ropEU, ropRU, thROC, thROG, twRO, twROZ
RAGDATA_DP_SERVER=LATAM

# Idioma dos nomes e descrições (en, ko, ja, pt, ru, fr, de, es, th, cn)
RAGDATA_DP_LANGUAGE=pt

# Onde ficam as tabelas de jogo e o cache HTTP (padrão: ~/.cache/ragdata)
# RAGDATA_CACHE_DIR=

# Validade do cache de respostas externas, em segundos (padrão: 30 dias)
# RAGDATA_CACHE_TTL=2592000
