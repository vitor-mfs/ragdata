# Chave da API do Divine Pride — pegue a sua em https://www.divine-pride.net/account
DIVINE_PRIDE_API_KEY=

# Servidor consultado no Divine Pride. O cliente LATAM usa a base publicada como bRO.
RAGDATA_DP_SERVER=bRO

# Onde ficam as tabelas de jogo e o cache HTTP (padrão: ~/.cache/ragdata)
# RAGDATA_CACHE_DIR=

# Validade do cache de respostas externas, em segundos (padrão: 30 dias)
# RAGDATA_CACHE_TTL=2592000
